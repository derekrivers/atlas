recommended_settings:
  temperature: 0
  max_output_tokens: 16000
template_variables:
  - product_key            # e.g. "ATLAS"
  - documents              # list of {path, sha, content}
  - valid_anchors          # the resolvable source_anchors to choose from:
                           # list of {anchor, heading}, derived from AnchorIndex
  - current_backlog_yaml   # verbatim epics/tickets/dependencies YAML, or null on first run
  - frozen_ticket_keys     # keys with status in_progress or later
  - next_key_hint          # informational only; the model never assigns keys
  - proposal_json_schema   # generated from the Pydantic models at render time
