{
  "name": "@atlas/operator-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run build:bundle",
    "build:bundle": "vite build",
    "lint": "eslint .",
    "api:generate": "cd ../.. && UV_CACHE_DIR=${UV_CACHE_DIR:-/tmp/uv-cache} UV_LINK_MODE=${UV_LINK_MODE:-copy} uv run python -m atlas.tools.operator_ui_openapi",
    "api:check": "cd ../.. && UV_CACHE_DIR=${UV_CACHE_DIR:-/tmp/uv-cache} UV_LINK_MODE=${UV_LINK_MODE:-copy} uv run python -m atlas.tools.operator_ui_openapi --check",
    "test": "npm run test:acceptance && npm run test:browser && npm run test:e2e",
    "test:core": "npm run test:acceptance && npm run test:browser",
    "test:acceptance": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "typecheck": "tsc -b",
    "verify:core": "npm run api:check && npm run lint && npm run typecheck && npm run test:core && npm run build:bundle",
    "verify": "npm run verify:core && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-direction": "1.1.1",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/vite": "4.1.14",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-router": "1.132.47",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "input-otp": "1.4.2",
    "lucide-react": "0.545.0",
    "react": "19.2.0",
    "react-day-picker": "9.11.1",
    "react-dom": "19.2.0",
    "react-hook-form": "7.64.0",
    "react-top-loading-bar": "3.0.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.14",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@types/node": "24.7.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react-swc": "4.1.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.0",
    "eslint-plugin-react-refresh": "0.4.23",
    "globals": "16.4.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.62.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
