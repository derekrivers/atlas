{
  "$defs": {
    "ActorType": {
      "description": "Who or what created a record (data-model §2.2, attribution §1.5).",
      "enum": [
        "human",
        "agent",
        "system"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "EntityStatus": {
      "description": "Generic lifecycle status for knowledge entities (data-model §2.3).",
      "enum": [
        "draft",
        "active",
        "archived",
        "deprecated"
      ],
      "title": "EntityStatus",
      "type": "string"
    },
    "OperatorActionOutcome": {
      "description": "Terminal outcome stored on an operator action receipt.",
      "enum": [
        "succeeded",
        "refused",
        "failed",
        "conflict"
      ],
      "title": "OperatorActionOutcome",
      "type": "string"
    },
    "OperatorActionResultCode": {
      "description": "Server-controlled terminal result vocabulary for operator commands.",
      "enum": [
        "action_succeeded",
        "action_refused",
        "stale_state",
        "action_failed",
        "external_timeout",
        "evidence_transport_failed",
        "evidence_authentication_failed",
        "evidence_rate_limit_failed",
        "evidence_malformed_source",
        "action_conflict"
      ],
      "title": "OperatorActionResultCode",
      "type": "string"
    }
  },
  "description": "Append-only receipt for one governed operator command.",
  "properties": {
    "action": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "after_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntityStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "before_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntityStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Created By Id",
      "type": "string"
    },
    "created_by_type": {
      "$ref": "#/$defs/ActorType"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "idempotency_key_identity": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Idempotency Key Identity",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/OperatorActionOutcome"
    },
    "request_fingerprint": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Request Fingerprint",
      "type": "string"
    },
    "result_code": {
      "$ref": "#/$defs/OperatorActionResultCode"
    },
    "result_metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          }
        ]
      },
      "propertyNames": {
        "enum": [
          "affected_count",
          "changed",
          "confidence"
        ]
      },
      "title": "Result Metadata",
      "type": "object"
    },
    "target_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "target_type": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Target Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "correlation_id",
    "action",
    "target_type",
    "target_id",
    "created_by_type",
    "created_by_id",
    "idempotency_key_identity",
    "request_fingerprint",
    "outcome",
    "result_code",
    "created_at",
    "completed_at"
  ],
  "title": "OperatorActionReceipt",
  "type": "object"
}
