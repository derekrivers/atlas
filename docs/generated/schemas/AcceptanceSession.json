{
  "$defs": {
    "AcceptanceAssessmentSnapshot": {
      "description": "Structured derived fields from the initial exact-head assessment.",
      "properties": {
        "ahead_by": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ahead By"
        },
        "ancestry": {
          "enum": [
            "current",
            "behind",
            "diverged",
            "indeterminate"
          ],
          "title": "Ancestry",
          "type": "string"
        },
        "base_sha_source": {
          "enum": [
            "live_branch",
            "historical_pr_snapshot"
          ],
          "title": "Base Sha Source",
          "type": "string"
        },
        "behind_by": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Behind By"
        },
        "compare_status": {
          "anyOf": [
            {
              "enum": [
                "ahead",
                "behind",
                "diverged",
                "identical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compare Status"
        },
        "eligibility": {
          "enum": [
            "eligible",
            "merged",
            "closed",
            "draft",
            "fork_head",
            "non_main"
          ],
          "title": "Eligibility",
          "type": "string"
        },
        "integration_status": {
          "enum": [
            "current",
            "behind",
            "diverged",
            "conflicted",
            "indeterminate",
            "ineligible"
          ],
          "title": "Integration Status",
          "type": "string"
        },
        "merge_base_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Merge Base Sha"
        },
        "mergeability": {
          "enum": [
            "mergeable",
            "conflicted",
            "indeterminate"
          ],
          "title": "Mergeability",
          "type": "string"
        },
        "pr_draft": {
          "title": "Pr Draft",
          "type": "boolean"
        },
        "pr_merged": {
          "title": "Pr Merged",
          "type": "boolean"
        },
        "pr_state": {
          "title": "Pr State",
          "type": "string"
        }
      },
      "required": [
        "pr_state",
        "pr_draft",
        "pr_merged",
        "base_sha_source",
        "mergeability",
        "ancestry",
        "eligibility",
        "integration_status"
      ],
      "title": "AcceptanceAssessmentSnapshot",
      "type": "object"
    },
    "AcceptanceCriterionSnapshot": {
      "description": "One server-read criterion identified by ticket key and stored index.",
      "properties": {
        "criterion_index": {
          "minimum": 0,
          "title": "Criterion Index",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "ticket_key": {
          "pattern": "^ATLAS-[0-9]+$",
          "title": "Ticket Key",
          "type": "string"
        }
      },
      "required": [
        "ticket_key",
        "criterion_index",
        "text"
      ],
      "title": "AcceptanceCriterionSnapshot",
      "type": "object"
    },
    "AcceptanceEvidenceSummary": {
      "description": "Bounded, payload-free projection of evidence at one exact head.",
      "properties": {
        "agent_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Agent Count",
          "type": "integer"
        },
        "checks_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Checks Count",
          "type": "integer"
        },
        "complete_pin_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Complete Pin Count",
          "type": "integer"
        },
        "docs_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Docs Count",
          "type": "integer"
        },
        "exact_head_pin_complete": {
          "title": "Exact Head Pin Complete",
          "type": "boolean"
        },
        "exact_head_pin_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Exact Head Pin Count",
          "type": "integer"
        },
        "failed_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Failed Count",
          "type": "integer"
        },
        "human_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Human Count",
          "type": "integer"
        },
        "latest_source_event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Source Event At"
        },
        "new_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "New Count",
          "type": "integer"
        },
        "not_applicable_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Not Applicable Count",
          "type": "integer"
        },
        "oldest_source_event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oldest Source Event At"
        },
        "passed_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Passed Count",
          "type": "integer"
        },
        "pending_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Pending Count",
          "type": "integer"
        },
        "pin_complete": {
          "title": "Pin Complete",
          "type": "boolean"
        },
        "reviews_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Reviews Count",
          "type": "integer"
        },
        "system_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "System Count",
          "type": "integer"
        },
        "total_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Total Count",
          "type": "integer"
        },
        "warning_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        }
      },
      "required": [
        "total_count",
        "new_count",
        "checks_count",
        "reviews_count",
        "docs_count",
        "system_count",
        "human_count",
        "agent_count",
        "pending_count",
        "passed_count",
        "failed_count",
        "warning_count",
        "not_applicable_count",
        "complete_pin_count",
        "exact_head_pin_count",
        "pin_complete",
        "exact_head_pin_complete"
      ],
      "title": "AcceptanceEvidenceSummary",
      "type": "object"
    },
    "AcceptanceReadinessAssessment": {
      "description": "The full final live identity that admitted manual-merge readiness.",
      "properties": {
        "base_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Base Ref",
          "type": "string"
        },
        "base_repository": {
          "maxLength": 257,
          "minLength": 1,
          "title": "Base Repository",
          "type": "string"
        },
        "base_sha": {
          "title": "Base Sha",
          "type": "string"
        },
        "criteria_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Criteria Fingerprint",
          "type": "string"
        },
        "eligibility": {
          "const": "eligible",
          "title": "Eligibility",
          "type": "string"
        },
        "head_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Head Ref",
          "type": "string"
        },
        "head_repository": {
          "maxLength": 257,
          "minLength": 1,
          "title": "Head Repository",
          "type": "string"
        },
        "head_sha": {
          "title": "Head Sha",
          "type": "string"
        },
        "integration_status": {
          "const": "current",
          "title": "Integration Status",
          "type": "string"
        },
        "pr_number": {
          "exclusiveMinimum": 0,
          "title": "Pr Number",
          "type": "integer"
        },
        "repository_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Repository Name",
          "type": "string"
        },
        "repository_owner": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Repository Owner",
          "type": "string"
        },
        "verdict_id": {
          "format": "uuid",
          "title": "Verdict Id",
          "type": "string"
        }
      },
      "required": [
        "verdict_id",
        "repository_owner",
        "repository_name",
        "pr_number",
        "head_ref",
        "head_sha",
        "head_repository",
        "base_ref",
        "base_sha",
        "base_repository",
        "eligibility",
        "integration_status",
        "criteria_fingerprint"
      ],
      "title": "AcceptanceReadinessAssessment",
      "type": "object"
    },
    "AcceptanceSessionBlockingReason": {
      "description": "Closed, secret-free reasons used by preflight, freshness and history.",
      "enum": [
        "pr_unknown",
        "pr_merged",
        "pr_closed",
        "pr_draft",
        "pr_fork_head",
        "pr_non_main",
        "integration_behind",
        "integration_diverged",
        "integration_conflicted",
        "integration_indeterminate",
        "external_state_indeterminate",
        "close_set_empty",
        "unknown_ticket",
        "ticket_not_review_required",
        "active_session_exists",
        "idempotency_key_reused",
        "repository_mismatch",
        "pr_number_mismatch",
        "head_ref_mismatch",
        "head_sha_mismatch",
        "head_repository_mismatch",
        "base_ref_mismatch",
        "base_sha_mismatch",
        "base_repository_mismatch",
        "close_set_mismatch",
        "eligibility_mismatch",
        "integration_status_mismatch",
        "criteria_mismatch",
        "session_stale",
        "evidence_not_ready",
        "confirmations_not_ready",
        "verification_not_passed",
        "session_unknown",
        "session_not_verifiable",
        "verification_already_completed",
        "verification_pending",
        "verification_failed",
        "verification_warning",
        "verification_not_applicable",
        "verification_malformed",
        "verification_close_set_mismatch",
        "verified_head_invalid",
        "verified_head_mismatch",
        "stored_history_invalid",
        "readiness_persistence_failed",
        "external_read_timeout",
        "external_response_malformed",
        "external_read_failed"
      ],
      "title": "AcceptanceSessionBlockingReason",
      "type": "string"
    },
    "AcceptanceSessionLifecycle": {
      "description": "Stored state-machine milestones and terminal outcomes.",
      "enum": [
        "preflight_passed",
        "evidence_ready",
        "confirmations_ready",
        "verification_passed",
        "merge_ready",
        "stale",
        "blocked",
        "failed"
      ],
      "title": "AcceptanceSessionLifecycle",
      "type": "string"
    },
    "AcceptanceSessionStep": {
      "description": "The historical summaries retained on every acceptance session.",
      "enum": [
        "preflight",
        "evidence",
        "confirmations",
        "verification",
        "readiness"
      ],
      "title": "AcceptanceSessionStep",
      "type": "string"
    },
    "AcceptanceSessionStepState": {
      "description": "Stored state for one historical step summary.",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ],
      "title": "AcceptanceSessionStepState",
      "type": "string"
    },
    "AcceptanceStepSummary": {
      "description": "Bounded historical status for one acceptance step.",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcceptanceEvidenceSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "readiness": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcceptanceReadinessAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reasons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AcceptanceSessionBlockingReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "receipt_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Receipt Ids",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/AcceptanceSessionStepState"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcceptanceVerificationSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "state"
      ],
      "title": "AcceptanceStepSummary",
      "type": "object"
    },
    "AcceptanceVerificationSummary": {
      "description": "Bounded identity and verdict from one canonical in-process evaluation.",
      "properties": {
        "blocking_check_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Blocking Check Count",
          "type": "integer"
        },
        "head_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Head Commit"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "ticket_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Ticket Count",
          "type": "integer"
        },
        "verdict_id": {
          "format": "uuid",
          "title": "Verdict Id",
          "type": "string"
        }
      },
      "required": [
        "verdict_id",
        "status",
        "ticket_count",
        "blocking_check_count"
      ],
      "title": "AcceptanceVerificationSummary",
      "type": "object"
    },
    "ActorType": {
      "description": "Who or what created a record (data-model §2.2, attribution §1.5).",
      "enum": [
        "human",
        "agent",
        "system"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "EvidenceStatus": {
      "description": "Outcome of an evidence record or verification check (data-model §2.5).",
      "enum": [
        "pending",
        "passed",
        "failed",
        "warning",
        "not_applicable"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    }
  },
  "description": "One immutable-head, durable PR acceptance attempt.",
  "properties": {
    "base_ref": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Base Ref",
      "type": "string"
    },
    "base_repository": {
      "maxLength": 257,
      "minLength": 1,
      "title": "Base Repository",
      "type": "string"
    },
    "base_sha": {
      "title": "Base Sha",
      "type": "string"
    },
    "blocking_reasons": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AcceptanceSessionBlockingReason"
      },
      "title": "Blocking Reasons",
      "type": "array"
    },
    "close_set": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Close Set",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Created By Id",
      "type": "string"
    },
    "created_by_type": {
      "$ref": "#/$defs/ActorType"
    },
    "creation_idempotency_key_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Creation Idempotency Key Identity",
      "type": "string"
    },
    "criteria_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Criteria Fingerprint",
      "type": "string"
    },
    "criteria_snapshot": {
      "items": {
        "$ref": "#/$defs/AcceptanceCriterionSnapshot"
      },
      "title": "Criteria Snapshot",
      "type": "array"
    },
    "head_ref": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Head Ref",
      "type": "string"
    },
    "head_repository": {
      "maxLength": 257,
      "minLength": 1,
      "title": "Head Repository",
      "type": "string"
    },
    "head_sha": {
      "title": "Head Sha",
      "type": "string"
    },
    "historical_readiness_reasons": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AcceptanceSessionBlockingReason"
      },
      "title": "Historical Readiness Reasons",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "initial_assessment": {
      "$ref": "#/$defs/AcceptanceAssessmentSnapshot"
    },
    "lifecycle": {
      "$ref": "#/$defs/AcceptanceSessionLifecycle"
    },
    "pr_number": {
      "exclusiveMinimum": 0,
      "title": "Pr Number",
      "type": "integer"
    },
    "repository_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Repository Name",
      "type": "string"
    },
    "repository_owner": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Repository Owner",
      "type": "string"
    },
    "staled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Staled At"
    },
    "step_summaries": {
      "additionalProperties": {
        "$ref": "#/$defs/AcceptanceStepSummary"
      },
      "propertyNames": {
        "$ref": "#/$defs/AcceptanceSessionStep"
      },
      "title": "Step Summaries",
      "type": "object"
    },
    "stored_merge_ready": {
      "default": false,
      "title": "Stored Merge Ready",
      "type": "boolean"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "repository_owner",
    "repository_name",
    "pr_number",
    "close_set",
    "head_ref",
    "head_sha",
    "head_repository",
    "base_ref",
    "base_sha",
    "base_repository",
    "initial_assessment",
    "criteria_snapshot",
    "criteria_fingerprint",
    "creation_idempotency_key_identity",
    "created_by_type",
    "created_by_id",
    "lifecycle",
    "step_summaries",
    "created_at",
    "updated_at"
  ],
  "title": "AcceptanceSession",
  "type": "object"
}
